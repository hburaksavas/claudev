<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.claudev</groupId>
        <artifactId>claudev</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-bootstrap</artifactId>
    <packaging>jar</packaging>
    <name>app-bootstrap</name>
    <description>Spring Boot main() + JavaFX Application entry point, single-JVM lifecycle wiring (D6, D15). Assembles every module into the runnable/packagable application.</description>

    <dependencies>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>provider-api</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>operation-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>ui-shell</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>platform-windows</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>secret-store-dpapi</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>secret-store-legacy</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>adapter-rabbitmq</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>adapter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.claudev</groupId>
            <artifactId>adapter-fe-pipeline</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>claudev</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.claudev.app.ClaudevApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
