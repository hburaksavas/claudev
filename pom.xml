<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.claudev</groupId>
    <artifactId>claudev</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>claudev</name>
    <description>Windows desktop dev-workspace orchestrator (RabbitMQ, Redis, corporate FE pipelines) — JavaFX + Spring Boot, single JVM.</description>

    <modules>
        <module>domain-core</module>
        <module>provider-api</module>
        <module>operation-engine</module>
        <module>platform-windows</module>
        <module>persistence</module>
        <module>secret-store-dpapi</module>
        <module>secret-store-legacy</module>
        <module>adapter-rabbitmq</module>
        <module>adapter-redis</module>
        <module>adapter-fe-pipeline</module>
        <module>ui-shell</module>
        <module>app-bootstrap</module>
        <module>packaging</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Pinned for reproducibility/SBOM accuracy (D14/licensing gate). Verify against
             Maven Central for the latest patch release before M0 sign-off; do not bump
             casually once RABBITMQ_RUNTIME.md / packaging spikes have pinned against these. -->
        <spring-boot.version>3.3.5</spring-boot.version>
        <javafx.version>21.0.4</javafx.version>
        <jna.version>5.15.0</jna.version>
        <sqlite-jdbc.version>3.49.1.0</sqlite-jdbc.version>
        <lettuce.version>6.4.0.RELEASE</lettuce.version>
        <junit.version>5.11.0</junit.version>
        <mockito.version>5.14.1</mockito.version>
        <assertj.version>3.26.3</assertj.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- in-repo modules -->
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>provider-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>operation-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>platform-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>secret-store-dpapi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>secret-store-legacy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>adapter-rabbitmq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>adapter-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>adapter-fe-pipeline</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.claudev</groupId>
                <artifactId>ui-shell</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- third-party -->
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- every module gets a test framework for free -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
